# Copy to .env.local for local development, and set the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL of the deployed site (used for canonical URLs, sitemap and Open Graph images).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (optional) ──────────────────────────────────────────────
# Leave blank and every form validates but shows "Submissions aren't switched on yet — nothing was saved."
# Set both to store submissions. The service-role key is SERVER-ONLY: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
